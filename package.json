{
  "name": "forge-cli",
  "version": "0.5.1",
  "description": "A local-first AI coding agent for cloud APIs and open-source models through Ollama, LM Studio, and llama.cpp.",
  "type": "module",
  "bin": {
    "forge": "./bin/forge.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/h3ex0/forge-cli.git"
  },
  "homepage": "https://github.com/h3ex0/forge-cli#readme",
  "bugs": {
    "url": "https://github.com/h3ex0/forge-cli/issues"
  },
  "files": [
    "bin",
    "dist",
    "docs/adr",
    "README.md",
    "ROADMAP.md",
    "SECURITY.md"
  ],
  "keywords": [
    "ai",
    "cli",
    "agent",
    "openai",
    "anthropic",
    "gemini",
    "ollama",
    "qwen",
    "local-ai",
    "llama-cpp",
    "developer-tools"
  ],
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc -p .",
    "dev": "tsc -p . -w",
    "start": "node bin/forge.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p . --noEmit",
    "verify": "npm run typecheck && npm test && npm run build"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@napi-rs/keyring": "^1.3.0",
    "ajv": "^8.20.0",
    "chalk": "^5.3.0",
    "cli-highlight": "^2.1.11",
    "commander": "^15.0.0",
    "fast-glob": "^3.3.2",
    "figlet": "^1.7.0",
    "gradient-string": "^2.0.2",
    "ink": "^7.1.1",
    "marked": "^12.0.2",
    "marked-terminal": "^7.1.0",
    "ora": "^8.0.1",
    "react": "^19.2.8",
    "string-argv": "^0.3.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/figlet": "^1.5.8",
    "@types/gradient-string": "^1.1.6",
    "@types/node": "^20.14.0",
    "@types/react": "^19.2.18",
    "typescript": "^5.5.4",
    "vitest": "^4.1.10"
  }
}
